# Copy to secrets.env (git-ignored) and fill in. NEVER commit secrets.env.
# Oracle JDBC URL (service name form) and application-schema credentials.
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//oracle-host.example.com:1521/INCIDENTDB
SPRING_DATASOURCE_USERNAME=INCIDENT_DASH
SPRING_DATASOURCE_PASSWORD=change-me
# HS256 signing key, MINIMUM 32 bytes: openssl rand -base64 48
INCIDENT_JWT_SECRET=change-me-to-at-least-32-random-bytes
# Bootstrap administrator password, MINIMUM 12 characters (read on first boot only).
INCIDENT_ADMIN_PASSWORD=change-me-12-chars-min
# Only when INCIDENT_AI_ENABLED=true in the ConfigMap; otherwise leave empty.
INCIDENT_AI_API_KEY=

# Copy to deploy/.env and change every value before running the demo stack.
#   cp deploy/.env.example deploy/.env
#
# deploy/.env is gitignored. Nothing here is a real credential — these are LOCAL DEMO values for a
# stack that holds production-derived incident data, so treat the machine it runs on accordingly.

# Oracle SYSTEM password (container bootstrap).
ORACLE_PASSWORD=localdev

# Password for the INCIDENT_DASH application schema.
INCIDENT_DASH_DB_PASSWORD=IncidentDash#Demo2026

# Bootstrap administrator password. MINIMUM 12 CHARACTERS — R__SeedAdmin refuses to seed a weak
# credential and the migration failure aborts application startup, so a short value here surfaces
# as "the service won't boot", not as a warning.
INCIDENT_ADMIN_PASSWORD=AdminDemo#2026!

# HS256 signing key. MINIMUM 32 BYTES — jjwt rejects a key shorter than the digest.
INCIDENT_JWT_SECRET=demo-only-signing-secret-0123456789abcdef

# Public origin of the dashboard. Must match where the browser actually loads it from: this is
# echoed back as Access-Control-Allow-Origin, and the refresh cookie requires credentials mode,
# which is incompatible with a wildcard.
DASHBOARD_ORIGIN=http://localhost:8090

# Base URL of the source Redmine install, e.g. https://redmine.internal.example
# BUILD-TIME only: Vite inlines it into the bundle, so changing it requires a rebuild of the
# dashboard image (`docker compose build incident-dashboard`), not just a restart.
# Left empty, the incident drawer disables "Open in Redmine" and says the deployment is
# unconfigured — deliberately, rather than linking to a placeholder host.
REDMINE_BASE_URL=
